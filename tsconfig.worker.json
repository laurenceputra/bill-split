{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022"], "module": "ESNext", "moduleResolution": "Bundler", "strict": true, "noUnusedLocals": true,
    "skipLibCheck": true, "types": ["@cloudflare/workers-types"], "noEmit": true, "allowSyntheticDefaultImports": true
  }, "include": ["src/worker", "src/db", "src/domain", "src/shared"]
}
