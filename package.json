{
  "name": "billsplit-cloudflare-pwa",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && node scripts/finalize-service-worker.mjs",
    "typecheck": "tsc -b",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --config vitest.config.ts --exclude=**/*.integration.test.ts --exclude=**/*.performance.test.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts --exclude=src/db/group-summary.performance.test.ts && vitest run --config vitest.migration.config.ts",
    "test:performance": "vitest run --config vitest.integration.config.ts src/db/group-summary.performance.test.ts",
    "test:all": "npm test && npm run test:performance",
    "test:watch": "vitest --config vitest.config.ts --exclude=**/*.integration.test.ts --exclude=**/*.performance.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:audit": "playwright test tests/e2e/audit.spec.ts",
    "e2e:prepare": "node tests/e2e/prepare-db.mjs",
    "e2e:server": "node tests/e2e/start-server.mjs",
    "cf:build": "node scripts/prepare-cloudflare-build.mjs && npm run test:unit && npm run build",
    "cf:deploy": "node scripts/deploy-cloudflare-build.mjs",
    "validate:deploy": "node scripts/validate-cloudflare-deploy.mjs",
    "deploy": "npm run build && npm run validate:deploy && wrangler deploy --config=wrangler.deploy.toml --keep-vars",
    "deploy:dry-run": "npm run build && npm run validate:deploy && wrangler deploy --config=wrangler.deploy.toml --keep-vars --dry-run",
    "cf:types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config=wrangler.toml",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --config=wrangler.deploy.toml",
    "db:seed": "wrangler d1 execute DB --local --config=wrangler.toml --file=./seed/seed.sql",
    "validate:large-ledger": "node scripts/validate-large-ledger.mjs"
  },
  "dependencies": {
    "@clerk/backend": "^3.16.10",
    "@clerk/react": "^6.14.5",
    "@clerk/shared": "^4.29.3",
    "@hono/zod-validator": "^0.4.3",
    "hono": "^4.7.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.6.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.3",
    "@cloudflare/workers-types": "^5.20260831.1",
    "@playwright/test": "^1.62.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.4.1",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^4.1.11",
    "wrangler": "4.128.0"
  }
}
