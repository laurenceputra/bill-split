{
  "name": "billsplit-cloudflare-pwa",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && node scripts/finalize-service-worker.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:audit": "playwright test tests/e2e/audit.spec.ts",
    "e2e:prepare": "node tests/e2e/prepare-db.mjs",
    "e2e:server": "node tests/e2e/start-server.mjs",
    "deploy": "npm run build && wrangler deploy --env=\"\"",
    "deploy:dry-run": "npm run build && wrangler deploy --env=\"\" --dry-run",
    "cf:types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply bill-split --local",
    "db:migrate:remote": "wrangler d1 migrations apply bill-split --remote",
    "db:seed": "wrangler d1 execute bill-split --local --file=./seed/seed.sql",
    "validate:large-ledger": "node scripts/validate-large-ledger.mjs"
  },
  "dependencies": {
    "@clerk/backend": "^3.16.10",
    "@clerk/react": "^6.14.5",
    "@clerk/shared": "^4.29.3",
    "@hono/zod-validator": "^0.4.3",
    "hono": "^4.7.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.6.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250821.0",
    "@playwright/test": "^1.62.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.4.1",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "wrangler": "^4.23.0"
  }
}
